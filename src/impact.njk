---
title: Impact — Things 4 Good
description: Every nonprofit Things 4 Good has supported since 2021 — who picked it, the year, and what we raised together. Filter and sort the full list.
---
{% extends "base.njk" %}

{% block content %}

<!-- ============================ HEADER ============================ -->
<section class="section page-head" id="head">
  <div class="hero-glow" aria-hidden="true"></div>
  <div class="wrap">
    <a class="back-link" href="/">&larr; Things 4 Good</a>
    <p class="eyebrow">Community impact</p>
    <h1 style="font-family:var(--serif);font-weight:500;font-size:clamp(2.4rem,5.4vw,4rem);letter-spacing:-.02em;line-height:1.02;max-width:16ch">Where the good has gone.</h1>
    <p class="lead" style="margin-top:18px">Every year each of us chooses one cause, and everyone who buys candles decides where their donation goes. Since 2021, that simple ritual has sent <b style="color:var(--ink)">100% of every candle donation</b> to {{ metrics.orgCount }} organizations and counting.</p>

    <div class="sumstrip">
      <div class="s acc"><b>${{ metrics.grandTotalDisplay }}</b><span>Raised since 2021</span></div>
      <div class="s acc2"><b>{{ metrics.orgCount }}</b><span>Organizations</span></div>
      <div class="s"><b>{{ metrics.yearCount }}</b><span>Years</span></div>
      <div class="s"><b>~{{ metrics.totalCandlesDisplay }}</b><span>Candles poured</span></div>
    </div>

    <div class="impact-principle">
      <p><b>Four family picks.</b> One cause from each of us, every fall.</p>
      <p><b>Community choice.</b> Support one, split across all four, or ask for a specific allocation.</p>
      <p><b>Every dollar onward.</b> We cover materials so the full candle donation goes to good.</p>
    </div>
  </div>
</section>

<!-- ============================ LIST ============================ -->
<section class="section" id="list" style="padding-top:clamp(20px,3vw,32px)">
  <div class="wrap">
    <div class="ledger-head reveal">
      <p class="eyebrow">Explore the ledger</p>
      <h2 class="t">Filter the story.</h2>
      <p class="lead">Look at a single sale year, follow one family member&rsquo;s causes, or sort the full list by amount raised. The filters are shareable, so each view has its own URL.</p>
      <div class="filter-story" id="filterStory">Showing the full Things 4 Good impact ledger across every sale year and event.</div>
    </div>

    <div class="controls" id="controls">
      <div class="ctrl select">
        <label class="lab" for="whoSel">Picked by</label>
        <select id="whoSel">
          <option value="all">Everyone</option>
          <option value="Jamie">Jamie</option>
          <option value="Tammy">Tammy</option>
          <option value="Mazie">Mazie</option>
          <option value="Tyler">Tyler</option>
        </select>
      </div>
      <div class="ctrl select">
        <label class="lab" for="eventSel">Event</label>
        <select id="eventSel">
          <option value="all">All events</option>
          {% for ev in metrics.eventList %}
          <option value="{{ ev.slug }}">{{ ev.name }}{% if ev.kind == "special-event" %} ({{ ev.year }}){% endif %}</option>
          {% endfor %}
        </select>
      </div>
      <div class="ctrl select">
        <label class="lab" for="sort">Sort</label>
        <select id="sort" aria-label="Sort nonprofits">
          <option value="year-desc">Newest first</option>
          <option value="year-asc">Oldest first</option>
          <option value="amt-desc">Raised: high to low</option>
          <option value="amt-asc">Raised: low to high</option>
          <option value="name-asc">Name: A to Z</option>
        </select>
      </div>
    </div>

    <p class="result-count" id="count">Showing all {{ metrics.orgCount }} organizations</p>
    <div class="impact-grid" id="grid"></div>
    <div class="empty" id="empty" style="display:none">
      <b>No causes match that.</b>
      Try clearing a filter or your search.
    </div>

  </div>
</section>

<!-- ============================ STORIES ============================ -->
<section class="section section--paper2" id="stories" style="padding-block:clamp(48px,7vw,84px)">
  <div class="wrap">
    <div class="sec-head reveal">
      <p class="eyebrow">Year by year</p>
      <h2 class="t">Read the sale stories.</h2>
      <p class="lead">The ledger shows where the dollars went. The journal posts add the texture: what sold, what surprised us, what the charts revealed, and what we learned for next year.</p>
    </div>

    <div class="annual-grid">
      {% for ev in metrics.annualStories %}
      <article class="annual-card reveal">
        <div class="annual-top">
          <span class="jyear">{{ ev.year }}</span>
          <span class="jraised">${{ ev.raisedDisplay }}</span>
        </div>
        <h3>{{ ev.name }}</h3>
        <p class="annual-takeaway">{{ ev.takeaway }}</p>
        <p>{{ ev.candles }} candles &middot; {{ ev.participants }} neighbors &middot; {{ ev.posts.length }} {% if ev.posts.length == 1 %}post{% else %}posts{% endif %}</p>
        <div class="post-list">
          {% for post in ev.posts %}
          <a href="{{ post.url }}" target="_blank" rel="noopener"><span>{{ post.type }}</span>{{ post.title }} <i aria-hidden="true">&rarr;</i></a>
          {% endfor %}
        </div>
      </article>
      {% endfor %}
    </div>
  </div>
</section>

<!-- ============================ CLOSE ============================ -->
<section class="section">
  <div class="wrap">
    <div class="impact-close reveal">
      <div>
        <p class="eyebrow">Next chapter</p>
        <h3>Follow the next sale.</h3>
        <p>The latest impact stories live on the blog, and the 2026 sale details go first to Candle Fundraiser subscribers.</p>
      </div>
      <div class="impact-close-actions">
        <a class="btn btn--primary" href="{{ site.updatesUrl }}" target="_blank" rel="noopener">Get sale updates <span class="arr">&rarr;</span></a>
        <a class="btn btn--ghost" href="{{ site.blogUrl }}" target="_blank" rel="noopener">Read the blog</a>
      </div>
    </div>
  </div>
</section>

{% endblock %}

{% block scripts %}
<style>
  @keyframes fadeUp { from { opacity:0; transform: translateY(10px); } to { opacity:1; transform:none; } }
</style>
<script>
  // ---- data (flattened from src/_data/events.json via metrics.nonprofits) ----
  // per-org `amount` is the exact figure from each year's tally.
  // `logo`: a filename in src/images/logos/ (e.g. "oceanites.png"); shown as the card icon when set.
  // `reason`: the picker's own words; "" hides the "Why … picked it" details (e.g. 2021–22, not yet backfilled).
  const ORGS = {{ metrics.nonprofits | dump | safe }};
  const EVENTS = {{ metrics.eventList | dump | safe }};

  const fmt = (n) => "$" + n.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  const state = { who:"all", event:"all", sort:"year-desc" };

  const grid = document.getElementById('grid');
  const countEl = document.getElementById('count');
  const emptyEl = document.getElementById('empty');
  const filterStoryEl = document.getElementById('filterStory');
  const eventBySlug = new Map(EVENTS.map(e => [e.slug, e]));

  function escapeHTML(str) {
    return String(str).replace(/[&<>"']/g, (ch) => ({
      "&": "&amp;",
      "<": "&lt;",
      ">": "&gt;",
      '"': "&quot;",
      "'": "&#39;"
    }[ch]));
  }

  function excerpt(str, max = 230) {
    if (str.length <= max) return str;
    const clipped = str.slice(0, max);
    const sentence = clipped.lastIndexOf(". ");
    const word = clipped.lastIndexOf(" ");
    const tidy = sentence > 120
      ? clipped.slice(0, sentence + 1)
      : clipped.slice(0, word > 160 ? word : max).trim().replace(/[,:;/-]$/, "");
    return tidy + "…";
  }

  function updateFilterStory(list) {
    const event = state.event === "all" ? null : eventBySlug.get(state.event);
    const raised = list.reduce((s, o) => s + o.amount, 0);
    const whoText = state.who === "all" ? "" : `${state.who}'s picks`;
    let text = "Showing the full Things 4 Good impact ledger across every sale year and event.";
    if (event && state.who !== "all") {
      text = `${whoText} in ${event.name}: ${list.length} ${list.length === 1 ? "organization" : "organizations"} and ${fmt(raised)} raised.`;
    } else if (event) {
      const candleNote = event.candles ? `, ${event.candles} candles` : "";
      text = `${event.name}: ${fmt(event.raised)} raised for ${event.orgCount} ${event.orgCount === 1 ? "organization" : "organizations"}${candleNote}. ${event.takeaway}`;
    } else if (state.who !== "all") {
      text = `${whoText} across the fundraiser: ${list.length} ${list.length === 1 ? "organization" : "organizations"} and ${fmt(raised)} raised.`;
    }
    filterStoryEl.textContent = text;
  }

  function apply() {
    let list = ORGS.filter(o => {
      if (state.who !== "all" && o.who !== state.who) return false;
      if (state.event !== "all" && o.event !== state.event) return false;
      return true;
    });
    const s = state.sort;
    list.sort((a,b) => {
      if (s === "year-desc") return b.year - a.year || b.amount - a.amount;
      if (s === "year-asc")  return a.year - b.year || b.amount - a.amount;
      if (s === "amt-desc")  return b.amount - a.amount;
      if (s === "amt-asc")   return a.amount - b.amount;
      if (s === "name-asc")  return a.name.localeCompare(b.name);
      return 0;
    });

    grid.innerHTML = list.map(o => {
      const collective = o.who === "Everyone";
      const whoLabel = o.who;
      const glyph = o.logo
        ? `<div class="glyph haslogo"><img src="/images/logos/${o.logo}" alt="${o.name} logo" /></div>`
        : "";
      const eventTag = o.eventKind === "special-event"
        ? `<span class="ebadge">${o.eventName}</span>`
        : "";
      const whyLabel = collective ? "Why we supported it" : `Why ${o.who} picked it`;
      const reason = o.reason || "";
      const safeReason = escapeHTML(reason);
      const safeExcerpt = escapeHTML(excerpt(reason));
      const why = reason
        ? `<div class="why-note">
            <div class="why-k">${whyLabel}</div>
            <blockquote>&ldquo;${safeExcerpt}&rdquo;<cite>&mdash; ${whoLabel}</cite></blockquote>
            ${reason.length > 230 ? `<details class="why-full"><summary>Read full note</summary><blockquote>&ldquo;${safeReason}&rdquo;</blockquote></details>` : ""}
          </div>`
        : "";
      return `
      <article class="icard">
        <div class="itop">
          ${glyph}
          <div class="cardtags">
            <span class="who-pill" data-who="${o.who}">${whoLabel}</span>
            <span class="ybadge">${o.year}</span>
            ${eventTag}
          </div>
        </div>
        <a class="iname" href="${o.url}" target="_blank" rel="noopener">${o.name}</a>
        <p class="iblurb">${o.blurb}</p>
        ${why}
        <div class="imeta">
          <div class="iamt"><b>${fmt(o.amount)}</b><span>raised</span></div>
        </div>
        <a class="go" href="${o.url}" target="_blank" rel="noopener">Visit <span class="arr">&rarr;</span></a>
      </article>`;
    }).join('');

    const n = list.length;
    const raised = list.reduce((s, o) => s + o.amount, 0);
    const head = n === ORGS.length
      ? `Showing all <b>${n}</b> organizations`
      : `Showing <b>${n}</b> of ${ORGS.length} organizations`;
    countEl.innerHTML = n
      ? `${head} &middot; <b>${fmt(raised)}</b> raised`
      : head;
    emptyEl.style.display = n ? 'none' : 'block';
    grid.style.display = n ? 'grid' : 'none';
    grid.style.animation = 'none'; void grid.offsetWidth; grid.style.animation = 'fadeUp .4s ease';
    updateFilterStory(list);
  }

  // ---- shareable filters: each control <-> a URL query param ----
  // e.g. /impact/?who=Tyler&event=candle-sale-2024 links straight to a filtered view.
  const SELS = { who: 'whoSel', event: 'eventSel', sort: 'sort' };
  const DEFAULTS = { who: 'all', event: 'all', sort: 'year-desc' };

  const isValidOption = (id, val) =>
    [...document.getElementById(id).options].some(o => o.value === val);

  function readURL() {
    const p = new URLSearchParams(location.search);
    for (const key in SELS) {
      const v = p.get(key);
      if (v && isValidOption(SELS[key], v)) {
        state[key] = v;
        document.getElementById(SELS[key]).value = v;
      }
    }
  }

  function writeURL() {
    const p = new URLSearchParams();
    for (const key in SELS) {
      if (state[key] !== DEFAULTS[key]) p.set(key, state[key]);
    }
    const qs = p.toString();
    history.replaceState(null, '', qs ? `${location.pathname}?${qs}` : location.pathname);
  }

  for (const key in SELS) {
    document.getElementById(SELS[key]).addEventListener('change', (e) => {
      state[key] = e.target.value;
      apply();
      writeURL();
    });
  }

  readURL();
  apply();
</script>
{% endblock %}
