---
title: Sign — This year's causes — Things 4 Good
permalink: /print/causes/
---
{% extends "print.njk" %}

{% block style %}
  .head { display: grid; grid-template-columns: 1fr auto; gap: 0.28in; align-items: center; padding: 0 0 0.2in; }
  .head h1 { font-size: 40pt; }
  /* On a narrower sheet (Safari prints larger) the heading shrinks with it to stay on one line. */
  .head h1 { font-size: min(40pt, 7cqw); }
  .lead { font-size: 12.5pt; }
  .causes { flex: 1; display: grid; grid-template-columns: 1fr 1fr; grid-template-rows: minmax(0, 1fr) minmax(0, 1fr); min-height: 0; gap: 0.2in; padding-bottom: 0.22in; }
  .cause { --c: var(--marigold); --c-d: var(--marigold-d); --c-t: var(--marigold-t); border: 2px solid var(--c); border-radius: 16px; overflow: hidden; display: flex; flex-direction: column; background: #fff; }
  .cause.tammy { --c: var(--pine); --c-d: var(--pine-d); --c-t: var(--pine-t); }
  .cause.mazie { --c: var(--berry); --c-d: var(--berry-d); --c-t: var(--berry-t); }
  .cause.tyler { --c: var(--sky); --c-d: var(--sky-d); --c-t: var(--sky-t); }
  .cause .logo { flex: 0 1 1.35in; min-height: 0.55in; padding: 0.16in 0.3in; background: #fff; border-bottom: 1px solid var(--c-t); }
  .cause .logo img { display: block; width: 100%; height: 100%; object-fit: contain; }
  .cause .text { flex: 1 0 auto; padding: 0.16in 0.22in 0.2in; background: var(--c-t); display: flex; flex-direction: column; }
  .cause .who { font-family: var(--hand); font-weight: 700; font-size: 22pt; line-height: 1; color: var(--c-d); }
  .cause h2 { font-size: 21pt; margin-top: 6px; }
  .cause p { margin-top: 8px; font-size: 12.5pt; line-height: 1.38; }
{% endblock %}

{% block content %}
<div class="head">
  <div>
  <p class="eyebrow">Where your donation goes</p>
  <h1>This year&rsquo;s <em>four</em> causes.</h1>
  <p class="lead">Each of us picked one. Every candle is a donation, and <b>100% goes to these four</b>. When you pay, add a note with the causes you&rsquo;d like to support.</p>
  </div>
  <div class="more">{{ ("https://things4good.xyz/" ~ causes.year ~ "/") | qrSvg | safe }}<span class="hand">Why we picked them</span><small>things4good.xyz/{{ causes.year }}</small></div>
</div>
<div class="causes">
  {% for who in ["Jamie", "Tammy", "Mazie", "Tyler"] %}{% set c = causes.list | pickFor(who) %}{% if c %}
  <div class="cause {{ who | lower }}">
    <div class="logo"><img src="/images/logos/{{ c.logo }}" alt="{{ c.name }}" /></div>
    <div class="text">
      <span class="who">{{ who }}&rsquo;s pick</span>
      <h2>{{ c.name }}</h2>
      <p>{{ c.blurb }}</p>
    </div>
  </div>
  {% endif %}{% endfor %}
</div>
{% endblock %}

