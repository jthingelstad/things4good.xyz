---
title: Order candles — Things 4 Good
description: Order Things 4 Good candles online, for pickup or SPS delivery. Before the sale, order ahead; after it, order what's left. 100% goes to this year's four causes.
---
{% extends "base.njk" %}

{# site.json's orders sets the window for this page (orders.js) and for the service behind it (npm run infra -- orders). Shut, the page says why and never calls the service. Open, it asks /api/stock, and believes the service's window over this build's: a window closes at its minute, before any rebuild. Stock and prices come only from /api/stock. #}

{% block content %}

<section class="section page-head" id="head">
  <div class="hero-glow" aria-hidden="true"></div>
  <div class="wrap">
    <a class="back-link" href="/">&larr; Things 4 Good</a>
    {% set h1 = 'style="font-family:var(--serif);font-weight:500;font-size:clamp(2.4rem,5.4vw,4rem);letter-spacing:-.02em;line-height:1.02;max-width:18ch"' %}
    {% set causesLink %}<a href="/{{ causes.year }}/" style="color:var(--marigold-d);font-weight:600;text-decoration:none">this year&rsquo;s four causes</a>{% endset %}
    {% set shown = ("paused-sale" if orders.saleOn else "paused-count") if orders.paused else orders.window %}
    <div data-window="preorder"{% if shown != "preorder" %} hidden{% endif %}>
      <p class="eyebrow">Order ahead</p>
      <h1 {{ h1 | safe }}>Order your candles before the sale.</h1>
      <p class="lead" style="margin-top:18px">The {{ site.saleYear }} sale is {{ site.saleDates | safe }}. Order now and we&rsquo;ll have your candles ready. We&rsquo;re still pouring, so if a scent runs short we&rsquo;ll make more for you. Pick them up anytime during the sale, or have them delivered at SPS. Online orders are divided evenly across {{ causesLink | safe }}, or across the ones you leave checked.{% if orders.preorder %} Open through {{ orders.closesDay }} at {{ orders.closesTime }} Central.{% endif %}</p>
    </div>
    <div data-window="after"{% if shown != "after" %} hidden{% endif %}>
      <p class="eyebrow">After the sale</p>
      <h1 {{ h1 | safe }}>Order the candles we have left.</h1>
      <p class="lead" style="margin-top:18px">The {{ site.saleYear }} sale is over and we still have some candles. Pick what you&rsquo;d like, then pick them up or, if you&rsquo;re on the SPS team, have them delivered at work. Online orders are divided evenly across {{ causesLink | safe }}, or across the ones you leave checked.{% if orders.after %} Open through {{ orders.closesDay }} at {{ orders.closesTime }} Central.{% endif %}</p>
    </div>
    <div data-window="paused-sale"{% if shown != "paused-sale" %} hidden{% endif %}>
      <p class="eyebrow">Sale weekend</p>
      <h1 {{ h1 | safe }}>Come see us at the sale.</h1>
      <p class="lead" style="margin-top:18px">Online orders are paused while the sale is on, because we can&rsquo;t keep the counts right with candles going out the door. They reopen {{ orders.reopens or "after the sale" }} with whatever&rsquo;s left.</p>
    </div>
    <div data-window="paused-count"{% if shown != "paused-count" %} hidden{% endif %}>
      <p class="eyebrow">After the sale</p>
      <h1 {{ h1 | safe }}>We&rsquo;re counting what&rsquo;s left.</h1>
      <p class="lead" style="margin-top:18px">The {{ site.saleYear }} sale is over. Thank you! Online orders are paused while we count, and they reopen {{ orders.reopens or "soon" }} for a week with whatever candles we have.</p>
    </div>
    <div data-window="closed"{% if shown != "closed" %} hidden{% endif %}>
      <p class="eyebrow">Online orders</p>
      <h1 {{ h1 | safe }}>Online orders are closed.</h1>
      <p class="lead" style="margin-top:18px">We open them about a week before the fall sale, and again for a week after it. Get sale updates and you&rsquo;ll hear first.</p>
    </div>
    <div class="ev-cta" id="order-shut"{% if orders.open %} hidden{% endif %}>
      {% if orders.saleOn %}<a class="btn btn--primary" href="/{{ site.saleYear }}/">See the sale <span class="arr">&rarr;</span></a>{% endif %}
      <a class="btn {{ 'btn--ghost' if orders.saleOn else 'btn--primary' }}" href="{{ site.updatesUrl }}" data-tinylytics-event="updates.click" data-tinylytics-event-value="order-shut" target="_blank" rel="noopener">Get sale updates{% if not orders.saleOn %} <span class="arr">&rarr;</span>{% endif %}</a>
      <a class="btn btn--ghost" href="mailto:{{ site.email }}">Email us</a>
    </div>
  </div>
</section>

<section class="section" id="order" style="padding-top:clamp(20px,3vw,32px)">
  <div class="wrap">
    <noscript><p class="order-message">This form needs JavaScript. Email <a href="mailto:{{ site.email }}">{{ site.email }}</a> and we&rsquo;ll take your order that way.</p></noscript>
    <p class="order-message" id="order-status" role="status" aria-live="polite"{% if not orders.open %} hidden{% endif %}>{{ "Loading the scents&hellip;" if orders.preorder else "Checking what we have left&hellip;" }}</p>

    <form class="order-grid" id="order-form" hidden novalidate>
      <div id="order-products"></div>

      <aside class="order-panel" aria-label="Your order">
        <h2>Your order</h2>
        <ul class="order-summary" id="order-summary"></ul>
        <p class="order-total"><span>Total donation</span><b id="order-total" aria-live="polite">$0</b></p>

        <label class="order-field">Name
          <input name="name" type="text" autocomplete="name" maxlength="100" required />
        </label>
        <label class="order-field">Email
          <input name="email" type="email" autocomplete="email" maxlength="254" required />
        </label>
        <label class="order-field">Mobile <small>so we can follow up</small>
          <input name="mobile" type="tel" autocomplete="tel" maxlength="30" required />
        </label>

        <fieldset class="order-field order-choice">
          <legend>How should we get them to you?</legend>
          <label><input type="radio" name="fulfillment" value="Pickup" checked /> <span><b>Pickup</b> {% if orders.preorder %}Anytime during the sale. {% endif %}Jamie will email you the details.</span></label>
          <label><input type="radio" name="fulfillment" value="SPS delivery" /> <span><b>SPS delivery</b> For SPS team members, delivered at work.</span></label>
        </fieldset>

        {# Every cause starts checked, and a buyer unchecks any to leave out (Jamie, 2026-11-07). Each value is
           the cause's name in Grist, which the order service checks (causes.json `grist`). #}
        {% if causes.list.length %}
        <fieldset class="order-field order-choice">
          <legend>Where should your donation go? <small>Uncheck any you&rsquo;d like to leave out</small></legend>
          {% for c in causes.list %}
          <label><input type="checkbox" name="causes" value="{{ c.grist }}" checked /> <span><b>{{ c.name }}</b> {{ c.who }}&rsquo;s pick</span></label>
          {% endfor %}
        </fieldset>
        {% endif %}

        <label class="order-field">Anything we should know? <small>optional</small>
          <textarea name="note" rows="2" maxlength="500"></textarea>
        </label>

        {# The spam trap: people never see this, and a filled one is refused. #}
        <div class="order-trap" aria-hidden="true">
          <label>Leave this empty <input name="website" type="text" tabindex="-1" autocomplete="off" /></label>
        </div>

        {# Cloudflare Turnstile. It shows itself only when it needs a click. #}
        <div class="order-check" id="order-check"></div>
        <p class="order-error" id="order-error" role="alert" hidden></p>
        <button class="btn btn--primary order-submit" id="order-submit" type="submit" disabled>Place order</button>
        <p class="order-fine">{% if orders.preorder %}We set your candles aside, and pour more if a scent runs short.{% else %}Your order holds these candles right away.{% endif %} Please send your donation soon after you order, because we may release an order that stays unpaid.</p>
        <p class="order-fine">We&rsquo;ll add you to our family&rsquo;s email list. Unsubscribe anytime.</p>
      </aside>
    </form>

    <div class="order-done" id="order-done" tabindex="-1" hidden>
      <span class="hand" style="font-size:1.9rem">Thank you!</span>
      <h2 id="order-done-title"></h2>
      <p class="order-done-total">Your total is <b id="order-done-total"></b>.</p>
      <p id="order-done-causes" hidden></p>
      <ul class="order-summary" id="order-done-items"></ul>
      <a class="btn btn--primary" href="/pay/">Send your donation <span class="arr">&rarr;</span></a>
      <p id="order-done-next"></p>
      <p>This page is your confirmation, so nothing is emailed automatically. Questions? Email <a href="mailto:{{ site.email }}">{{ site.email }}</a>.</p>
    </div>
  </div>
</section>

{% endblock %}

{% block scripts %}
<script>
(() => {
  const ART = { {% for scent in candles.scents %}{{ scent.name | dump | safe }}: {{ scent.art | dump | safe }}{% if not loop.last %}, {% endif %}{% endfor %} };
  const GROUPS = [["Candle", "Candles"], ["XL candle", "XL candles"], ["Lid", "Candle lids"], ["Maker Night candle", "Maker Night"]];
  const EMAIL = {{ site.email | dump | safe }};
  // Grist's name for each cause, which the form sends, and the name the page shows.
  const CAUSES = { {% for c in causes.list %}{{ c.grist | dump | safe }}: {{ c.name | dump | safe }}{% if not loop.last %}, {% endif %}{% endfor %} };
  const CHECK_KEY = {{ site.turnstileSiteKey | dump | safe }};
  const LINE_MAX = 24, ORDER_MAX = 30;
  // A counted line says how many are left only once it's under a dozen (Jamie, 2026-11-07).
  const LOW = 12;
  // The window this page was built in, and when the sale ends, for the paused message.
  const BUILT = {{ orders.window | dump | safe }};
  const SALE_ENDS = Date.parse({{ orders.saleEnds | dump | safe }});

  const $ = (id) => document.getElementById(id);
  const form = $("order-form"), status = $("order-status"), errorBox = $("order-error"), submit = $("order-submit");
  const money = (n) => "$" + n.toLocaleString("en-US", { maximumFractionDigits: 2 });
  const sleep = (ms) => new Promise((resolve) => setTimeout(resolve, ms));
  const el = (tag, className, text) => {
    const node = document.createElement(tag);
    if (className) node.className = className;
    if (text !== undefined) node.textContent = text;
    return node;
  };

  let products = [];
  let current = BUILT; // A local name: `window` is the browser's.
  let sending = false;
  // The Turnstile widget, its latest token, and whether its script failed to load.
  let check = null, token = "", checkBroken = false;
  const cart = new Map();

  const say = (text) => { status.textContent = text; status.hidden = !text; };
  const sayError = (text) => { errorBox.textContent = text; errorBox.hidden = !text; };
  // The service's window wins over the build's: it shuts at its minute, and the pages catch up overnight.
  function showWindow(next) {
    current = next;
    const shown = next === "paused" ? (Date.now() < SALE_ENDS ? "paused-sale" : "paused-count") : next;
    for (const head of document.querySelectorAll("[data-window]")) head.hidden = head.dataset.window !== shown;
  }
  const closed = (next) => {
    form.hidden = true;
    say("");
    showWindow(["paused", "closed"].includes(next) ? next : "closed");
    $("order-shut").hidden = false;
  };

  const chosen = () => products.filter((p) => cart.get(p.id) > 0).map((p) => ({ ...p, quantity: cart.get(p.id) }));
  const count = () => chosen().reduce((sum, p) => sum + p.quantity, 0);

  function fillSummary(list, items) {
    list.replaceChildren(...items.map((p) => {
      const row = el("li");
      row.append(el("span", "", `${p.quantity} × ${p.name}`), el("span", "", money(p.quantity * p.price)));
      return row;
    }));
  }

  function refresh() {
    const items = chosen();
    fillSummary($("order-summary"), items);
    $("order-total").textContent = money(items.reduce((sum, p) => sum + p.quantity * p.price, 0));
    submit.disabled = sending || items.length === 0;
    const atMax = count() >= ORDER_MAX;
    for (const p of products) {
      const q = cart.get(p.id) || 0;
      const row = document.querySelector(`[data-product="${p.id}"]`);
      if (!row) continue;
      row.querySelector("output").textContent = q;
      row.querySelector("[data-less]").disabled = sending || q === 0;
      // A preorder candle is poured to order: no count, only the per-line cap.
      const most = p.limit ?? Math.min(p.left ?? LINE_MAX, LINE_MAX);
      row.querySelector("[data-more]").disabled = sending || atMax || q >= most;
      const notes = [];
      if (p.left === 0) notes.push("All gone");
      else if (p.left !== null && p.left < LOW) notes.push(`${p.left} available`);
      if (p.left !== null && most > 0 && most < Math.min(p.left, LINE_MAX)) notes.push(`${most} per order`);
      row.querySelector(".order-left").textContent = notes.map((note) => ` · ${note}`).join("");
      row.classList.toggle("is-out", most === 0);
    }
    if (atMax && !errorBox.textContent) sayError(`Online orders top out at ${ORDER_MAX}. For a bigger one, email ${EMAIL}.`);
    if (!atMax && errorBox.textContent.startsWith("Online orders top out")) sayError("");
  }

  function draw() {
    const box = $("order-products");
    box.replaceChildren();
    const known = GROUPS.map(([type]) => type);
    const groups = [...GROUPS, ...[...new Set(products.map((p) => p.type))].filter((t) => !known.includes(t)).map((t) => [t, t])];
    for (const [type, title] of groups) {
      const list = products.filter((p) => p.type === type);
      if (!list.length) continue;
      box.append(el("h2", "order-group", title));
      for (const p of list) {
        const row = el("div", "order-row");
        row.dataset.product = p.id;
        const art = ART[p.name] || ART[p.name.replace(/ XL$/, "")];
        const pic = el("div", "order-art");
        if (art) {
          const img = el("img");
          img.src = art; img.alt = ""; img.loading = "lazy"; img.decoding = "async";
          pic.append(img);
        }
        const about = el("div", "order-about");
        about.append(el("b", "", p.name), el("span", "", `${money(p.price)} donation`), el("span", "order-left"));
        const stepper = el("div", "order-stepper");
        const less = el("button", "", "−"), qty = el("output"), more = el("button", "", "+");
        less.type = more.type = "button";
        less.dataset.less = more.dataset.more = "";
        less.setAttribute("aria-label", `One less ${p.name}`);
        more.setAttribute("aria-label", `One more ${p.name}`);
        less.addEventListener("click", () => { cart.set(p.id, Math.max(0, (cart.get(p.id) || 0) - 1)); refresh(); });
        more.addEventListener("click", () => { cart.set(p.id, (cart.get(p.id) || 0) + 1); refresh(); });
        stepper.append(less, qty, more);
        row.append(pic, about, stepper);
        box.append(row);
      }
    }
    refresh();
  }

  async function loadStock() {
    let response;
    for (const wait of [0, 1500, 3000, 5000]) {
      await sleep(wait);
      response = await fetch("/api/stock").catch(() => null);
      if (response && response.status !== 429) break;
    }
    if (response && response.status === 503) {
      const body = await response.json().catch(() => ({}));
      if (body.open === false) return closed(body.window);
    }
    if (!response || !response.ok) return say(`We couldn’t load the candles. Try again in a minute, or email ${EMAIL}.`);
    const stock = await response.json();
    if (stock.window && stock.window !== current) showWindow(stock.window);
    products = stock.products;
    if (!products.length) return say("We’re all sold out. Thank you, everyone!");
    say("");
    form.hidden = false;
    draw();
    loadCheck();
  }

  // Loaded only once there is something to order. A token is good once and for five minutes; the widget
  // gets a fresh one on its own when one expires, and after reset().
  function loadCheck() {
    window.onOrderCheck = () => {
      check = turnstile.render("#order-check", {
        sitekey: CHECK_KEY,
        action: "order",
        appearance: "interaction-only",
        theme: "light",
        size: "flexible",
        callback: (t) => { token = t; },
        "expired-callback": () => { token = ""; },
        "error-callback": () => { token = ""; },
      });
    };
    const script = document.createElement("script");
    script.src = "https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit&onload=onOrderCheck";
    script.async = true;
    script.onerror = () => { checkBroken = true; };
    document.head.append(script);
  }

  async function checkToken() {
    for (let i = 0; i < 60 && !token && !checkBroken; i++) await sleep(250);
    return token;
  }

  function resetCheck() {
    token = "";
    if (check !== null) turnstile.reset(check);
  }

  // A retry with the same answers keeps its id, so the service can't take the order twice. Changed
  // answers are a new order.
  let requestId, lastAnswers;

  async function send(body) {
    const bytes = new TextEncoder().encode(body);
    const digest = await crypto.subtle.digest("SHA-256", bytes);
    const hash = [...new Uint8Array(digest)].map((b) => b.toString(16).padStart(2, "0")).join("");
    let response, data = {};
    // The service takes one request at a time, so a 429 from Lambda usually clears in a few seconds.
    for (const wait of [0, 2000, 4000, 8000]) {
      await sleep(wait);
      response = await fetch("/api/order", {
        method: "POST",
        headers: { "Content-Type": "application/json", "x-amz-content-sha256": hash },
        body,
      }).catch(() => null);
      data = response ? await response.json().catch(() => ({})) : {};
      const again = !response || response.status === 429 || response.status >= 500;
      if (!again || data.error === "slow-down" || data.open === false) break;
    }
    return { response, data };
  }

  function showDone(answers, items, total) {
    form.hidden = true;
    say("");
    $("order-done-title").textContent = `Your order is in, ${answers.name}.`;
    $("order-done-total").textContent = money(total);
    fillSummary($("order-done-items"), items);
    // Every cause checked is the even split across all of them.
    const picked = answers.causes || [];
    const doneCauses = $("order-done-causes");
    doneCauses.hidden = !picked.length;
    doneCauses.textContent = picked.length === Object.keys(CAUSES).length
      ? "It’s divided evenly across this year’s causes."
      : picked.length === 1
        ? `It all goes to ${CAUSES[picked[0]]}.`
        : `It’s divided evenly across ${new Intl.ListFormat("en", { type: "conjunction" }).format(picked.map((c) => CAUSES[c]))}.`;
    $("order-done-next").textContent = answers.fulfillment === "SPS delivery"
      ? "Jamie will get them to you at work."
      : current === "preorder"
        ? "Pick them up anytime during the sale. Jamie will email you the details."
        : "Jamie will email you the pickup details.";
    const done = $("order-done");
    done.hidden = false;
    done.focus();
    done.scrollIntoView({ block: "start" });
  }

  const FIELD_WORDS = { name: "your name", email: "your email", mobile: "your mobile number", note: "your note", fulfillment: "how to get them to you", causes: "the causes you picked", items: "the candles in your order" };

  form.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (sending) return;
    sayError("");
    const values = new FormData(form);
    const answers = {
      name: values.get("name").trim(),
      email: values.get("email").trim(),
      mobile: values.get("mobile").trim(),
      fulfillment: values.get("fulfillment"),
      note: values.get("note").trim(),
      // Left out when the page has no causes to show, which the service reads as all of them.
      causes: form.querySelector('input[name="causes"]') ? values.getAll("causes") : undefined,
      website: values.get("website"),
      items: chosen().map((p) => ({ product: p.id, quantity: p.quantity })),
    };
    if (!answers.items.length) return sayError("Pick at least one candle first.");
    if (!answers.name) return sayError("We need your name.");
    if (!answers.email.includes("@")) return sayError("We need your email.");
    if (answers.mobile.replace(/\D/g, "").length < 7) return sayError("We need your mobile number, so we can follow up.");
    if (answers.causes && !answers.causes.length) return sayError("Leave at least one cause checked.");

    const text = JSON.stringify(answers);
    if (text !== lastAnswers) { lastAnswers = text; requestId = crypto.randomUUID(); }
    const items = chosen();

    // Nothing changes while an order is on its way: a changed quantity would be a new order.
    sending = true;
    refresh();
    submit.textContent = "Placing your order…";
    // The token rides along but isn't one of the answers, so a fresh token keeps the same order.
    const proof = await checkToken();
    const { response, data } = proof
      ? await send(JSON.stringify({ ...answers, requestId, turnstile: proof }))
      : { response: null, data: { error: "no-check" } };
    sending = false;
    submit.textContent = "Place order";
    refresh();

    if (response && response.ok && data.ok) return showDone(answers, items, data.total);
    if (proof) resetCheck();
    if (data.error === "no-check") {
      return sayError(checkBroken
        ? `Our spam check didn’t load. Reload the page, or email ${EMAIL}.`
        : "Our spam check isn’t done yet. If a box shows above the button, check it, then press Place order again.");
    }
    if (data.error === "turnstile") return sayError("Our spam check didn’t go through. Wait a moment, then press Place order again.");
    if (data.open === false) return closed(data.window);
    if (response && response.status === 409 && data.short) {
      for (const short of data.short) {
        const p = products.find((x) => x.id === short.id);
        if (p) {
          p.left = short.left;
          p.limit = Math.min(p.limit ?? LINE_MAX, short.left);
        }
        cart.set(short.id, Math.min(cart.get(short.id) || 0, short.left));
      }
      refresh();
      const words = data.short.map((s) => (s.left ? `only ${s.left} ${s.name}` : `no ${s.name}`)).join(" and ");
      const next = chosen().length ? "so we changed your order. Check it and press Place order again." : "so your order is empty now. Pick something else, or come back another time.";
      return sayError(`We have ${words} left, ${next}`);
    }
    if (data.error === "unknown-product") return sayError(`One of those isn’t available online. Reload the page, or email ${EMAIL}.`);
    if (data.error === "invalid" && data.fields && data.fields.length) {
      return sayError(`Please check ${data.fields.map((f) => FIELD_WORDS[f]).filter(Boolean).join(" and ") || "your order"}.`);
    }
    if (data.error === "invalid") return sayError(`We couldn’t take that order. Please email ${EMAIL}.`);
    if (data.error === "slow-down") return sayError(`That’s a lot of orders in a short time. Try again in a while, or email ${EMAIL}.`);
    sayError(`Something went wrong on our end. Press Place order again: it won’t double up. Or email ${EMAIL}.`);
  });

  if (BUILT === "preorder" || BUILT === "after") loadStock();
})();
</script>
{% endblock %}
