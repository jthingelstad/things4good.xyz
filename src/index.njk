---
title: Things 4 Good — Handmade candles for good
description: Since 2021 the Thingelstad family has hand-poured wooden-wick candles for our annual fall fundraiser. Every candle is a $25 donation, and 100% goes to good causes.
card:
  kicker: "6th annual fall fundraiser"
  name: "Hand-poured candles, 100% for good."
  accent: "100% for good."
  photo: home
  saleFacts: true
---
{% extends "base.njk" %}

{% block content %}

<!-- ============================ HERO ============================ -->
<section class="section hero" id="hero">
  <div class="hero-glow" aria-hidden="true"></div>
  <div class="wrap hero-grid">
    <div class="hero-copy reveal">
      <p class="eyebrow">6th annual fall fundraiser</p>
      <h1 style="margin-top:18px">Hand-poured candles,
        <br /><span class="pine">100% for good.</span></h1>
      <p class="lead">Every fall our family pours hundreds of wooden-wick candles and sells them over one weekend to raise money for good causes. We&rsquo;ve done this since 2021. Each candle is a <b style="color:var(--ink)">$25 donation</b> and all of it goes to the non-profits!</p>
      <div class="hero-cta">
        {% if site.preorderSheet %}<a class="btn btn--primary" href="{{ site.preorderSheet }}" data-tinylytics-event="preorder.sheet" data-tinylytics-event-value="home-hero" target="_blank" rel="noopener">Preorder candles <span class="arr">&rarr;</span></a>
        <a class="btn btn--ghost" href="/candles/">See the scents</a>{% else %}<a class="btn btn--primary" href="{{ site.updatesUrl }}" data-tinylytics-event="updates.click" data-tinylytics-event-value="home-hero" target="_blank" rel="noopener">Get sale updates <span class="arr">&rarr;</span></a>
        <a class="btn btn--ghost" href="#good">See the impact</a>{% endif %}
      </div>
    </div>

    <div class="hero-art reveal">
      <div class="tape">
        <span class="hand">listen for the crackle&hellip;</span>
        <small>WOODEN WICK · HAND POURED</small>
      </div>
      <img class="ph" src="/images/candles.jpg" alt="Hand-poured wooden-wick candles" style="object-fit:cover" />
      <div class="badge" aria-hidden="true">
        <b>100%</b><span>to charity</span>
      </div>
    </div>
  </div>
</section>

<!-- ====================== RAISED STAT BAND ====================== -->
<section class="section section--ink raised" id="raised">
  <div class="wrap">
    <p class="eyebrow" style="justify-content:center">Since 2021, together we&rsquo;ve raised</p>
    <div class="big"><span class="pre">$</span><span id="counter" data-target="{{ metrics.grandTotal }}">{{ metrics.grandTotalDisplay }}</span></div>
    <p class="sub">&hellip;and 100% of it went to the non-profits below.</p>
    <div class="statrow">
      {% for stat in metrics.raisedStats %}
      <div class="stat reveal"><b>{{ stat.value | safe }}</b><span>{{ stat.label | safe }}</span></div>
      {% endfor %}
    </div>
  </div>
</section>

<!-- ========================= IMPACT ========================= -->
<section class="section section--paper2" id="impact">
  <div class="wrap">
    <div class="sec-head reveal">
      <p class="eyebrow">Five years of impact</p>
      <h2 class="t">The good, year by year.</h2>
      <p class="lead">Every fall folks show up and buy candles, and it adds up. Here&rsquo;s how the fundraiser has grown since we started in 2021.</p>
    </div>

    <div class="impact-chart reveal">
      {% for y in metrics.perYear %}
      <a class="bar{% if y.isLatest %} now{% endif %}" href="/{{ y.year }}/" data-tinylytics-event="chart.year" data-tinylytics-event-value="{{ y.year }}" aria-label="See the {{ y.year }} sale"><span class="val">${{ y.yearTotalDisplay }}</span><span class="col" style="height:{{ y.barHeightPct }}%;transition-delay:{{ 0.05 + loop.index0 * 0.08 }}s">{% if y.eventsRaised %}<span class="seg seg--event" style="flex:{{ y.eventsRaised }}" title="{{ y.yearEvents[0].name }}: ${{ y.eventsRaisedDisplay }}"></span>{% endif %}<span class="seg seg--candle" style="flex:{{ y.raised }}"></span></span><span class="yr">{{ y.year }}</span></a>
      {% endfor %}
    </div>
    <div class="chart-legend reveal">
      <span class="lg"><i class="sw sw--candle"></i> Candle sale</span>
      <span class="lg"><i class="sw sw--event"></i> Markets &amp; events</span>
    </div>

    <div class="impact-foot">
      {% for stat in metrics.footStats %}
      <div class="istat reveal"><b>{{ stat.value }}</b><span>{{ stat.label }}</span></div>
      {% endfor %}
    </div>

    <div class="journal-callout reveal">
      <div class="journal-head">
        <div>
          <p class="eyebrow">From the blog</p>
          <h3>The story behind the numbers.</h3>
        </div>
        <a class="journal-all" href="{{ site.blogUrl }}" target="_blank" rel="noopener">All Things 4 Good posts <span class="arr">&rarr;</span></a>
      </div>
      <div class="journal-grid">
        {% for post in metrics.journalPosts %}
        <a class="journal-card" href="{{ post.url }}" target="_blank" rel="noopener">
          <span class="jtype">{{ post.type }} &middot; {{ post.year }}</span>
          <h4>{{ post.title }}</h4>
          <p>{{ post.description }}</p>
          <span class="go">Read post <span class="arr">&rarr;</span></span>
        </a>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

<!-- ========================= THE SALE ========================= -->
<section class="section" id="sale">
  <div class="wrap">
    <div class="sec-head reveal">
      <p class="eyebrow">The 2026 sale</p>
      <h2 class="t">Mark your calendar.</h2>
      <p class="lead">One weekend and a table full of candles. Stop by, pick your scents and choose where your donation goes.</p>
    </div>

    <div class="sale-grid">
      <div class="when-card reveal">
        <div class="glow" aria-hidden="true"></div>
        <p class="eyebrow">Save the dates</p>
        <div class="when-days">
          <div class="when-day">
            <div class="dow">Saturday</div>
            <div class="dnum">7</div>
            <div class="mo">November 2026</div>
          </div>
          <div class="when-day">
            <div class="dow">Sunday</div>
            <div class="dnum">8</div>
            <div class="mo">November 2026</div>
          </div>
        </div>
        <p class="when-note">Pick up preorders anytime during the sale. Hours and the address come by email: join the Candle Fundraiser list, or <a href="mailto:{{ site.email }}" style="color:var(--marigold);font-weight:700;text-decoration:none">email Jamie</a>.</p>
        <a class="btn btn--primary" style="margin-top:20px" href="{{ site.updatesUrl }}" data-tinylytics-event="updates.click" data-tinylytics-event-value="home-when" target="_blank" rel="noopener">Get updates <span class="arr">&rarr;</span></a>
      </div>

      <div class="info-card reveal">
        <div class="info-row">
          <div class="k">The candle</div>
          <div class="v">A hand-poured, wooden-wick candle for a <b>$25 donation</b>. It&rsquo;s been the same price every year.</div>
        </div>
        <div class="info-row">
          <div class="k">Payment</div>
          <div class="v">
            Whatever&rsquo;s easiest for you. <a href="/pay/" style="color:var(--marigold-d);font-weight:600;text-decoration:none">How to pay &rarr;</a>
            <div class="pay">
              <span>Venmo</span><span>Cash App</span><span>Apple Pay</span><span>Zelle</span><span>Cash</span><span>Check</span>
            </div>
          </div>
        </div>
        <div class="info-row">
          <div class="k">Preorders</div>
          <div class="v">Ordering <b>six or more</b>? {% if site.preorderSheet %}Fill out our <a href="{{ site.preorderSheet }}" data-tinylytics-event="preorder.sheet" data-tinylytics-event-value="home-next" target="_blank" rel="noopener" style="color:var(--marigold-d);font-weight:600;text-decoration:none">preorder form</a> and we&rsquo;ll have them ready to pick up anytime during the sale.{% else %}The preorder sheet opens closer to the sale and goes to subscribers first. <a href="/preorder/" style="color:var(--marigold-d);font-weight:600;text-decoration:none">See preorder &amp; pickup notes</a>.{% endif %}</div>
        </div>
        <div class="info-row">
          <div class="k">Scents</div>
          <div class="v">{{ candles.scents | length }} this year, from {{ candles.scents[0].name }} to {{ (candles.scents | last).name }}{% if candles.secretScents %}, and a couple of new ones we&rsquo;re saving for the sale{% endif %}. <a href="/candles/" style="color:var(--marigold-d);font-weight:600;text-decoration:none">See the lineup</a>.</div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ===================== MAKER NIGHT TEASER ===================== -->
{% if site.makerNight %}
<section class="section" id="maker-night" style="padding-top:0">
  <div class="wrap">
    <div class="mn-band reveal">
      <div class="glow" aria-hidden="true"></div>
      <div class="mn-copy">
        {% set seatsLeft = makerNightSeats.total - makerNightSeats.sold %}<span class="tag">New &middot; {% if seatsLeft > 0 %}{{ seatsLeft }} of {{ makerNightSeats.total }} seats left{% else %}Sold out{% endif %}</span>
        <h3>Pour your own at Maker Night.</h3>
        <p>We&rsquo;re trying something new! We&rsquo;ll have six gold Maker Night candles at the sale. Each one is a ${{ site.makerNightDonation }} donation and a seat at an evening of pouring four candles of your own, in any scents from our library. All of it goes to the non-profits.</p>
      </div>
      <div class="mn-act">
        <a class="btn btn--primary" href="/maker-night/">Explore Maker Night <span class="arr">&rarr;</span></a>
        <span class="small">{{ site.makerNightDate }}, {{ site.makerNightTime }}</span>
      </div>
    </div>
  </div>
</section>
{% endif %}

<!-- ======================= HOW IT WORKS ======================= -->
<section class="section section--paper2" id="how">
  <div class="wrap">
    <div class="sec-head reveal">
      <p class="eyebrow">How it works</p>
      <h2 class="t">It&rsquo;s pretty simple.</h2>
    </div>
    <div class="steps">
      <div class="step reveal">
        <div class="num">1</div>
        <h3>We make them</h3>
        <p>We order wax, vessels, wicks and scent, weigh everything, and pour every candle by hand. Then we wait for them to cure and add the labels Mazie draws.</p>
      </div>
      <div class="step alt reveal">
        <div class="num">2</div>
        <h3>You pick yours</h3>
        <p>Come by the sale, pick your favorite scents and pay whichever way is easiest. Each candle is a $25 donation.</p>
      </div>
      <div class="step reveal">
        <div class="num">3</div>
        <h3>You choose where it goes</h3>
        <p>Split your donation however you like across the four causes we picked this year. After the sale we add it all up and send every dollar along.</p>
      </div>
    </div>
  </div>
</section>

<!-- ========================= THE STORY ========================= -->
<section class="section" id="story">
  <div class="wrap split">
    <div class="story-art reveal">
      <img class="ph" src="/images/making-candles.jpg" alt="Freshly poured candles curing with their wooden wicks, beside a pile of wicks and a kitchen scale" style="object-fit:cover" />
    </div>
    <div class="story reveal">
      <p class="eyebrow">How it started</p>
      <h2 class="t" style="margin-bottom:18px">It began with a&nbsp;<em class="it" style="font-style:italic">crackle</em>.</h2>
      <p>In 2019 Jamie bought a wooden-wick candle at a Christmas market and loved the sound it made. That <span class="crackle">crackle!</span> Friends who have known Jamie for a long time won&rsquo;t be surprised that a box of candle-making supplies showed up soon after.</p>
      <p>The first batch was a mess. It had about 20x too much fragrance and gave Jamie a terrible headache, so all of that wax got cut out with a knife and the stinky stuff went in the trash. Take two went much better. 🕯️</p>
      <p>The candles became gifts and people started asking to buy them. Nobody wanted to open a candle shop, so the family landed on one sale a year where <b>all of the money goes to non-profits</b>. There are four of us and we go by the Things, so each of us picks a cause every year. That&rsquo;s Things 4 Good!</p>
    </div>
  </div>
</section>

<!-- ========================= THE MAKERS ========================= -->
<section class="section section--paper2" id="makers">
  <div class="wrap">
    <div class="sec-head reveal">
      <p class="eyebrow">The four Things</p>
      <h2 class="t">Meet the makers.</h2>
      <p class="lead">We all pitch in on everything: ordering supplies, mixing, pouring and setting wicks. Each of us also picks a cause every year.</p>
    </div>
    <div class="makers">
      {% for m in site.makers %}
      <div class="maker reveal">
        <div class="ph{% if m.alt %} alt{% endif %}" role="img" aria-label="{% if m.photo %}{{ m.name }}{% else %}Portrait placeholder: {{ m.name }}{% endif %}">{% if m.photo %}<img class="ph-photo" src="{{ m.photo }}" alt="{{ m.name }}">{% else %}<span class="ph-label">{{ m.name }}</span>{% endif %}</div>
        <h3>{{ m.name }}</h3>
        <div class="role">{{ m.role }}</div>
        <a class="site" href="{{ m.url }}" target="_blank" rel="noopener">{{ m.site }} <span aria-hidden="true">&#8599;</span></a>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

<!-- ========================== THE GOOD ========================== -->
<section class="section" id="good">
  <div class="wrap">
    <div class="sec-head reveal">
      <p class="eyebrow">The good</p>
      <h2 class="t">Where the money goes.</h2>
      <p class="lead">The full $25 from every candle goes to a non-profit, and you decide which one. Each year the four of us each pick a cause we care about. Here&rsquo;s where it has gone.</p>
    </div>

    <h3 class="causes-head reveal" id="this-year">This year&rsquo;s four{% if not causes.list.length %} <span>announced {{ causes.announce }}</span>{% endif %}</h3>
    <div class="charities charities--four reveal">
      {% for who in ["Jamie", "Tammy", "Mazie", "Tyler"] %}{% set c = causes.list | pickFor(who) %}{% if c %}
      <a class="charity" href="{{ c.url }}" target="_blank" rel="noopener" data-tinylytics-event="nonprofit.visit" data-tinylytics-event-value="{{ c.slug }}">
        <div class="ctop">{% if c.logo %}<span class="glyph haslogo"><img src="/images/logos/{{ c.logo }}" alt="" /></span>{% else %}<span class="glyph">{{ c.who | first }}</span>{% endif %}<span class="yr">{{ c.who }}&rsquo;s pick</span></div>
        <h3>{{ c.name }}</h3>
        <p>{{ c.blurb }}</p>
        <span class="go">Visit <span class="arr">&rarr;</span></span>
      </a>{% else %}
      <div class="charity charity--soon">
        <div class="ctop"><span class="glyph">{{ who | first }}</span><span class="yr">{{ causes.year }}</span></div>
        <h3>{{ who }}&rsquo;s pick</h3>
        <p>Coming {{ "soon" if causes.list.length else causes.announce.split(",")[0] }}.</p>
      </div>{% endif %}{% endfor %}
    </div>

    {% if causes.list.length %}<p class="impact-link reveal pick-more"><a href="/{{ causes.year }}/">Read why we each picked them &rarr;</a></p>{% endif %}

    <div class="logo-wall reveal">
      {% for o in metrics.nonprofits %}<span class="lw"><img src="/images/logos/{{ o.logo }}" alt="{{ o.name }}" /></span>{% endfor %}
    </div>

    <div class="good-summary reveal">
      <a class="btn btn--primary" href="/impact/">See every cause &amp; what it raised <span class="arr">&rarr;</span></a>
    </div>
  </div>
</section>

<!-- ======================= NEXT STEPS ======================= -->
<section class="section section--paper2" id="next">
  <div class="wrap">
    <div class="sec-head reveal" style="text-align:center;margin-inline:auto">
      <p class="eyebrow" style="justify-content:center">Need the details?</p>
      <h2 class="t">There&rsquo;s more if you want it.</h2>
      <p class="lead" style="margin:16px auto 0;text-align:center">Here is every non-profit we&rsquo;ve supported, how preorders work, and the questions we get the most.</p>
    </div>

    <div class="path-grid">
      <a class="path-card reveal" href="/impact/">
        <span class="kicker">Impact</span>
        <h3>See every cause.</h3>
        <p>Browse all {{ metrics.orgCount }} organizations we&rsquo;ve supported, filter by year or event, and read our notes.</p>
        <span class="go">Explore impact <span class="arr">&rarr;</span></span>
      </a>
      <a class="path-card reveal" href="/preorder/">
        <span class="kicker">Preorder</span>
        <h3>Preorder and pickup.</h3>
        <p>Ordering six or more? Here&rsquo;s how preorders, pickup and payment work.</p>
        <span class="go">Pickup details <span class="arr">&rarr;</span></span>
      </a>
      <a class="path-card reveal" href="/faq/">
        <span class="kicker">FAQ</span>
        <h3>Get answers.</h3>
        <p>How the sale works, where the money goes, {% if site.makerNight %}what Maker Night is, {% endif %}and what to expect this year.</p>
        <span class="go">Read the FAQ <span class="arr">&rarr;</span></span>
      </a>
    </div>
  </div>
</section>

<!-- ========================= SUBSCRIBE ========================= -->
<section class="section section--pine subscribe" id="subscribe">
  <div class="wrap">
    <p class="eyebrow" style="justify-content:center">Stay in the loop</p>
    <h2 class="t" style="max-width:20ch;margin-inline:auto">Get the fall candle sale announcement.</h2>
    <p class="lead" style="margin:18px auto 0;text-align:center">Sign up to our family mailing list and check <b style="color:#fff">Candle Fundraiser</b> to be notified about sale dates, new scents and preorders. We hope to see you there!</p>
    <div class="sub-form" style="max-width:none">
      <a class="btn btn--primary" href="{{ site.updatesUrl }}" data-tinylytics-event="updates.click" data-tinylytics-event-value="home-subscribe" target="_blank" rel="noopener">Get sale updates <span class="arr">&rarr;</span></a>
    </div>
    <p class="sub-note">The list also has optional family and holiday-note segments.</p>
  </div>
</section>

{% endblock %}

{% block scripts %}
<script>
  // count-up for the raised total
  const counter = document.getElementById('counter');
  const target = parseInt(counter.dataset.target, 10);
  const fmt = (n) => n.toLocaleString('en-US');
  let counted = false;
  const countIO = new IntersectionObserver((entries) => {
    entries.forEach((e) => {
      if (e.isIntersecting && !counted) {
        counted = true;
        const dur = 1600, t0 = performance.now();
        const tick = (now) => {
          const p = Math.min((now - t0) / dur, 1);
          const eased = 1 - Math.pow(1 - p, 3);
          counter.textContent = fmt(Math.round(target * eased));
          if (p < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      }
    });
  }, { threshold: 0.5 });
  countIO.observe(counter);

  // shuffle the nonprofit logo wall so the order varies each visit
  const wall = document.querySelector('.logo-wall');
  if (wall) {
    const items = [...wall.children];
    for (let i = items.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [items[i], items[j]] = [items[j], items[i]];
    }
    const frag = document.createDocumentFragment();
    items.forEach((el) => frag.appendChild(el));
    wall.appendChild(frag);
  }
</script>
{% endblock %}
