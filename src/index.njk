---
title: Things 4 Good — Handmade candles for good
description: Since 2021 the Thingelstad family has hand-poured wooden-wick candles for our annual fall fundraiser. Every candle is a $25 donation, and 100% goes to good causes.
---
{% extends "base.njk" %}

{% block content %}

<!-- ============================ HERO ============================ -->
<section class="section hero" id="hero">
  <div class="hero-glow" aria-hidden="true"></div>
  <div class="wrap hero-grid">
    <div class="hero-copy reveal">
      <span class="pill"><span class="dot"></span>6th annual fall fundraiser</span>
      <h1 style="margin-top:18px">Hand-poured candles,
        <br /><span class="pine">100% for good.</span></h1>
      <p class="lead">Since 2021 the Thingelstad family has hand-poured wooden-wick candles for one weekend a year. Every candle is a $25 donation &mdash; and every dollar goes straight to causes we love.</p>
      <div class="hero-cta">
        <a class="btn btn--primary" href="#sale">See this year&rsquo;s sale <span class="arr">&rarr;</span></a>
        <a class="btn btn--ghost" href="#good">Meet the causes</a>
      </div>
      <div class="hero-meta">
        <span class="pill"><span class="dot"></span>Wooden wick &middot; hand-poured</span>
        <span class="pill"><span class="dot"></span>$25 each donation</span>
        <span class="pill"><span class="dot"></span>Minneapolis, MN</span>
      </div>
    </div>

    <div class="hero-art reveal">
      <div class="tape">
        <span class="hand">listen for the crackle&hellip;</span>
        <small>WOODEN WICK · HAND POURED</small>
      </div>
      <img class="ph" src="/images/candles.jpg" alt="Hand-poured wooden-wick candles" style="object-fit:cover" />
      <div class="badge" aria-hidden="true">
        <b>100%</b><span>to charity</span>
      </div>
    </div>
  </div>
</section>

<!-- ====================== RAISED STAT BAND ====================== -->
<section class="section section--ink raised" id="raised">
  <div class="wrap">
    <p class="eyebrow" style="justify-content:center">Since 2021, together we&rsquo;ve raised</p>
    <div class="big"><span class="pre">$</span><span id="counter" data-target="{{ metrics.grandTotal }}">{{ metrics.grandTotalDisplay }}</span></div>
    <p class="sub">&hellip;and 100% of it went to the nonprofits below.</p>
    <div class="statrow">
      {% for stat in metrics.raisedStats %}
      <div class="stat reveal"><b>{{ stat.value | safe }}</b><span>{{ stat.label | safe }}</span></div>
      {% endfor %}
    </div>
  </div>
</section>

<!-- ========================= IMPACT ========================= -->
<section class="section section--paper2" id="impact">
  <div class="wrap">
    <div class="sec-head reveal">
      <p class="eyebrow">Five years of impact</p>
      <h2 class="t">The good, year by year.</h2>
      <p class="lead">Every fall the community shows up &mdash; and the candles add up. Here&rsquo;s how the fundraiser has grown since we started in 2021.</p>
    </div>

    <div class="impact-chart reveal">
      {% for y in metrics.perYear %}
      <a class="bar{% if y.isLatest %} now{% endif %}" href="/impact/?event={{ y.slug }}" aria-label="See the {{ y.year }} organizations"><span class="val">${{ y.yearTotalDisplay }}</span><span class="col" style="height:{{ y.barHeightPct }}%;transition-delay:{{ 0.05 + loop.index0 * 0.08 }}s">{% if y.eventsRaised %}<span class="seg seg--event" style="flex:{{ y.eventsRaised }}" title="{{ y.yearEvents[0].name }}: ${{ y.eventsRaisedDisplay }}"></span>{% endif %}<span class="seg seg--candle" style="flex:{{ y.raised }}"></span></span><span class="yr">{{ y.year }}</span></a>
      {% endfor %}
    </div>
    <div class="chart-legend reveal">
      <span class="lg"><i class="sw sw--candle"></i> Candle sale</span>
      <span class="lg"><i class="sw sw--event"></i> Markets &amp; events</span>
    </div>

    <div class="impact-foot">
      {% for stat in metrics.footStats %}
      <div class="istat reveal"><b>{{ stat.value }}</b><span>{{ stat.label }}</span></div>
      {% endfor %}
    </div>

    <p class="impact-link reveal">We share full results &mdash; and the math behind them &mdash; on the blog after every sale. <a href="{{ site.blogUrl }}" target="_blank" rel="noopener">Read the write-ups &rarr;</a></p>
  </div>
</section>

<!-- ========================= THE SALE ========================= -->
<section class="section" id="sale">
  <div class="wrap">
    <div class="sec-head reveal">
      <p class="eyebrow">The 2026 sale</p>
      <h2 class="t">Mark your calendar.</h2>
      <p class="lead">One weekend, one table full of candles, and a whole lot of good. Stop by, pick your scents, and choose where your donation goes.</p>
    </div>

    <div class="sale-grid">
      <div class="when-card reveal">
        <div class="glow" aria-hidden="true"></div>
        <p class="eyebrow">Save the dates</p>
        <div class="when-days">
          <div class="when-day">
            <div class="dow">Saturday</div>
            <div class="dnum">7</div>
            <div class="mo">November 2026</div>
          </div>
          <div class="when-day">
            <div class="dow">Sunday</div>
            <div class="dnum">8</div>
            <div class="mo">November 2026</div>
          </div>
        </div>
        <p class="when-note">Pre-orders are picked up on <b style="color:#fff">Sunday</b>. Exact hours &amp; location are shared with subscribers closer to the weekend.</p>
        <a class="btn btn--primary" style="margin-top:20px" href="#subscribe">Get the details <span class="arr">&rarr;</span></a>
      </div>

      <div class="info-card reveal">
        <div class="info-row">
          <div class="k">The candle</div>
          <div class="v">A hand-poured, wooden-wick candle &mdash; <b>$25 donation</b> each. Same price it&rsquo;s been every year.</div>
        </div>
        <div class="info-row">
          <div class="k">Payment</div>
          <div class="v">
            However&rsquo;s easiest for you.
            <div class="pay">
              <span>Cash</span><span>Apple Pay</span><span>Venmo</span><span>Zelle</span>
            </div>
          </div>
        </div>
        <div class="info-row">
          <div class="k">Pre-orders</div>
          <div class="v">Ordering <b>six or more</b>? {% if site.preorderSheet %}Add your candles and scents to our <a href="{{ site.preorderSheet }}" target="_blank" rel="noopener" style="color:var(--marigold-d);font-weight:600;text-decoration:none">pre-order sheet</a> and we&rsquo;ll have them ready for Sunday pickup.{% else %}The pre-order sheet will open closer to the sale, and we&rsquo;ll share it with subscribers first.{% endif %}</div>
        </div>
        <div class="info-row">
          <div class="k">Scents</div>
          <div class="v">This year&rsquo;s lineup is announced closer to the sale. <a href="#subscribe" style="color:var(--marigold-d);font-weight:600;text-decoration:none">Subscribe</a> to be the first to know.</div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ===================== MAKER NIGHT TEASER ===================== -->
<section class="section" id="maker-night" style="padding-top:0">
  <div class="wrap">
    <div class="mn-band reveal">
      <div class="glow" aria-hidden="true"></div>
      <div class="mn-copy">
        <span class="tag">New for 2026 &middot; only 6 spots</span>
        <h3>Pour your own at Maker Night.</h3>
        <p>A new, intimate evening for six &mdash; hand-pour five Things 4 Good candles from our curated scents and take home a one-of-a-kind Maker Night candle. A $250 donation, 100% to good.</p>
      </div>
      <div class="mn-act">
        <a class="btn btn--primary" href="/maker-night/">Explore Maker Night <span class="arr">&rarr;</span></a>
        <span class="small">Held about two weeks before the sale</span>
      </div>
    </div>
  </div>
</section>

<!-- ======================= HOW IT WORKS ======================= -->
<section class="section section--paper2" id="how">
  <div class="wrap">
    <div class="sec-head reveal">
      <p class="eyebrow">How it works</p>
      <h2 class="t">Simple, by design.</h2>
    </div>
    <div class="steps">
      <div class="step reveal">
        <div class="num">1</div>
        <h3>We make them</h3>
        <p>We gather the materials, mix and hand-pour every candle, set the wicks, and wait for them to cure &mdash; then add labels Mazie designs herself.</p>
      </div>
      <div class="step alt reveal">
        <div class="num">2</div>
        <h3>You pick yours</h3>
        <p>Come by the sale, choose your favorite scents, and pay whichever way is easiest. Each candle is a flat $25 donation.</p>
      </div>
      <div class="step reveal">
        <div class="num">3</div>
        <h3>You choose the good</h3>
        <p>Split your donation however you like across the four causes our family picked this year. We tally it all and send every dollar along.</p>
      </div>
    </div>
  </div>
</section>

<!-- ========================= THE STORY ========================= -->
<section class="section" id="story">
  <div class="wrap split">
    <div class="story-art reveal">
      <div class="ph alt" role="img" aria-label="Photo placeholder: the family pouring candles">
        <span class="ph-label">family making candles</span>
      </div>
    </div>
    <div class="story reveal">
      <p class="eyebrow">How it started</p>
      <h2 class="t" style="margin-bottom:18px">It began with a&nbsp;<em class="it" style="font-style:italic">crackle</em>.</h2>
      <p>In 2019, Jamie bought a wooden-wick candle at a local Christmas market and fell in love with the sound &mdash; that soft <span class="crackle">crackle</span> of a tiny wood flame. So he started making his own. A few, then a few more.</p>
      <p>He gave them as gifts, and people started asking to buy them. Rather than open a candle shop, the family landed on something better: a once-a-year sale where <b>every dollar goes to charity</b>.</p>
      <p>Our family name is Thingelstad &mdash; shortened to <b>Things</b>. There are four of us. Four causes, every year. That&rsquo;s Things 4 Good.</p>
    </div>
  </div>
</section>

<!-- ========================= THE MAKERS ========================= -->
<section class="section section--paper2" id="makers">
  <div class="wrap">
    <div class="sec-head reveal">
      <p class="eyebrow">The four Things</p>
      <h2 class="t">Meet the makers.</h2>
      <p class="lead">We all pitch in &mdash; acquiring materials, managing production, mixing, pouring, and setting wicks. Each of us also picks a cause we care about.</p>
    </div>
    <div class="makers">
      {% for m in site.makers %}
      <div class="maker reveal">
        <div class="ph{% if m.alt %} alt{% endif %}" role="img" aria-label="{% if m.photo %}{{ m.name }}{% else %}Portrait placeholder: {{ m.name }}{% endif %}">{% if m.photo %}<img class="ph-photo" src="{{ m.photo }}" alt="{{ m.name }}">{% else %}<span class="ph-label">{{ m.name }}</span>{% endif %}</div>
        <h3>{{ m.name }}</h3>
        <div class="role">{{ m.role }}</div>
        <a class="site" href="{{ m.url }}" target="_blank" rel="noopener">{{ m.site }} <span aria-hidden="true">&#8599;</span></a>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

<!-- ========================== THE GOOD ========================== -->
<section class="section" id="good">
  <div class="wrap">
    <div class="sec-head reveal">
      <p class="eyebrow">The good</p>
      <h2 class="t">Where the money goes.</h2>
      <p class="lead">Every candle&rsquo;s full $25 goes to a nonprofit &mdash; and you decide which. Each year the four of us each pick a cause we care about. Here&rsquo;s where it&rsquo;s gone.</p>
    </div>

    <div class="logo-wall reveal">
      {% for o in metrics.nonprofits %}<span class="lw"><img src="/images/logos/{{ o.logo }}" alt="{{ o.name }}" /></span>{% endfor %}
    </div>

    <div class="good-summary reveal">
      <a class="btn btn--primary" href="/impact/">See every cause &amp; what it raised <span class="arr">&rarr;</span></a>
    </div>
  </div>
</section>

<!-- ======================= NEXT STEPS ======================= -->
<section class="section section--paper2" id="next">
  <div class="wrap">
    <div class="sec-head reveal" style="text-align:center;margin-inline:auto">
      <p class="eyebrow" style="justify-content:center">Need the details?</p>
      <h2 class="t">Everything has its place.</h2>
      <p class="lead" style="margin:16px auto 0;text-align:center">The homepage is the quick version. The details live on focused pages you can come back to when it is time to plan, preorder, or dig into the impact.</p>
    </div>

    <div class="path-grid">
      <a class="path-card reveal" href="/impact/">
        <span class="kicker">Impact</span>
        <h3>See every cause.</h3>
        <p>Browse all {{ metrics.orgCount }} supported organizations, filter by year or event, and read the family&rsquo;s notes.</p>
        <span class="go">Explore impact <span class="arr">&rarr;</span></span>
      </a>
      <a class="path-card reveal" href="/preorder/">
        <span class="kicker">Preorder</span>
        <h3>Plan a batch.</h3>
        <p>Ordering six or more? The preorder page keeps the timing, pickup, and payment notes together.</p>
        <span class="go">Preorder details <span class="arr">&rarr;</span></span>
      </a>
      <a class="path-card reveal" href="/faq/">
        <span class="kicker">FAQ</span>
        <h3>Get answers.</h3>
        <p>How the sale works, where the money goes, what Maker Night is, and what to expect this year.</p>
        <span class="go">Read the FAQ <span class="arr">&rarr;</span></span>
      </a>
    </div>
  </div>
</section>

<!-- ========================= SUBSCRIBE ========================= -->
<section class="section section--pine subscribe" id="subscribe">
  <div class="wrap">
    <p class="eyebrow" style="justify-content:center">Stay in the loop</p>
    <h2 class="t" style="max-width:18ch;margin-inline:auto">Be the first to know when the candles drop.</h2>
    <p class="lead" style="margin:18px auto 0;text-align:center">We&rsquo;ll send the dates, hours, location, and this year&rsquo;s scents &mdash; nothing else.</p>
    <form class="sub-form" action="mailto:{{ site.email }}" method="post" enctype="text/plain">
      <input type="email" name="email" placeholder="you@email.com" aria-label="Email address" required />
      <button class="btn btn--primary" type="submit">Notify me</button>
    </form>
    <p class="sub-note">Prefer to just reach out? Email <a href="mailto:{{ site.email }}" style="color:#fff;font-weight:600">{{ site.email }}</a>.</p>
  </div>
</section>

{% endblock %}

{% block subscribeHref %}#subscribe{% endblock %}

{% block scripts %}
<script>
  // count-up for the raised total
  const counter = document.getElementById('counter');
  const target = parseInt(counter.dataset.target, 10);
  const fmt = (n) => n.toLocaleString('en-US');
  let counted = false;
  const countIO = new IntersectionObserver((entries) => {
    entries.forEach((e) => {
      if (e.isIntersecting && !counted) {
        counted = true;
        const dur = 1600, t0 = performance.now();
        const tick = (now) => {
          const p = Math.min((now - t0) / dur, 1);
          const eased = 1 - Math.pow(1 - p, 3);
          counter.textContent = fmt(Math.round(target * eased));
          if (p < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      }
    });
  }, { threshold: 0.5 });
  countIO.observe(counter);

  // shuffle the nonprofit logo wall so the order varies each visit
  const wall = document.querySelector('.logo-wall');
  if (wall) {
    const items = [...wall.children];
    for (let i = items.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [items[i], items[j]] = [items[j], items[i]];
    }
    const frag = document.createDocumentFragment();
    items.forEach((el) => frag.appendChild(el));
    wall.appendChild(frag);
  }
</script>
{% endblock %}
