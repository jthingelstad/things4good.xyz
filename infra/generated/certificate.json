{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "things4good.xyz HTTPS certificate - external DNS validation",
  "Resources": {
    "Certificate": {
      "Type": "AWS::CertificateManager::Certificate",
      "Properties": {
        "DomainName": "things4good.xyz",
        "SubjectAlternativeNames": [
          "www.things4good.xyz"
        ],
        "ValidationMethod": "DNS"
      }
    }
  },
  "Outputs": {
    "CertificateArn": {
      "Value": {
        "Ref": "Certificate"
      }
    }
  }
}
